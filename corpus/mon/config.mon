// A MON document is one MoonBit-style expression.
Config {
  name: "moon-mon",
  version: "0.1.0",
  edition: 'E',
  ports: [8080, 8081],
  limits: { "cpu": 4, "memory": 1024U },
  owner: Some(Point { x: 1, y: 2 }),
  tags: ["notation", "moonbit"],
  window: 1..10,
  retired: None,
  metrics: Ok(3.5),
  banner: (
    #|MON reads data written the way
    #|MoonBit writes its literals.
  ),
  mask: b"\x0f\xf0",
  total: 9_000_000_000L,
  sealed: true,
}
